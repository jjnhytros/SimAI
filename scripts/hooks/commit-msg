#!/usr/bin/env bash
# Hook commit-msg — valida Conventional Commits.
#
# Formato accettato:
#   <type>(<scope>): <subject>
#   <type>: <subject>
#
# Type ammessi: feat fix docs style refactor perf test build ci chore revert

set -euo pipefail

commit_msg_file="${1:?commit message file required}"
first_line="$(head -n1 "$commit_msg_file")"

# Permette merge/revert automatici di git.
if [[ "$first_line" =~ ^(Merge|Revert|Initial commit) ]]; then
    exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_./-]+\))?!?: .{3,}'

if ! echo "$first_line" | grep -qE "$pattern"; then
    echo "❌ Commit message non conforme a Conventional Commits."
    echo ""
    echo "   Ricevuto: $first_line"
    echo "   Atteso:   <type>(<scope>): <subject>"
    echo ""
    echo "   Type ammessi: feat fix docs style refactor perf test build ci chore revert"
    echo "   Scope esempi:  core npc world economy sim db cli ui config docs build"
    echo ""
    exit 1
fi